# ── Django ────────────────────────────────────────────────────────────────────
# Generate a secure key: openssl rand -base64 50
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

# Set to 1 only during local development — never in production
DJANGO_DEBUG=0

# Comma-separated list of hostnames the app will be served from
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=pokerdb
POSTGRES_USER=pokerapp
POSTGRES_PASSWORD=change-me-strong-password-here

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to POST forms (include your domain with https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── League Config ─────────────────────────────────────────────────────────────
# Display name shown throughout the web UI
LEAGUE_NAME=My Poker League

# IANA timezone string for your league location — controls all date/time display
# Examples: America/Chicago, America/New_York, America/Los_Angeles, America/Phoenix
LEAGUE_TIMEZONE=America/Chicago

# ── Scoring Rules ─────────────────────────────────────────────────────────────
# Month (1-12) from which knockout tracking begins each season
KNOCKOUT_START_MONTH=4

# Number of top scores that count toward a player's season total (for SCORING_TOP_N_FROM_YEAR+)
SCORING_TOP_N=5

# First year in which the top-N scoring rule applies (all scores counted before this year)
SCORING_TOP_N_FROM_YEAR=2026

# ── Gunicorn (optional — these are the defaults) ──────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
